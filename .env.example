# ─────────────────────────────────────────────────────────────────────────────
# VibeVoice BR — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no repositório!
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="VibeVoice BR"
DEBUG=false
SECRET_KEY=TROQUE_POR_UMA_CHAVE_ALEATORIA_SEGURA_DE_32_CHARS

# ── Banco de Dados ────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=vibevoice_secret_mude_em_producao
DATABASE_URL=postgresql://vibevoice:vibevoice_secret_mude_em_producao@postgres:5432/vibevoice

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret_mude_em_producao
REDIS_URL=redis://:redis_secret_mude_em_producao@redis:6379/0

# ── VibeVoice TTS Engine ─────────────────────────────────────────────────────
# Opções de device: "cpu" ou "cuda" (NVIDIA GPU)
VIBEVOICE_DEVICE=cpu
VIBEVOICE_MODEL_PATH=/models/vibevoice
VIBEVOICE_REPO=vibevoice-community/VibeVoice

# ── Whisper ASR ───────────────────────────────────────────────────────────────
# Modelos disponíveis: tiny, base, small, medium, large, large-v3
# Recomendado: large-v3 para melhor precisão em PT-BR
WHISPER_MODEL=large-v3
# Opções: "cpu" ou "cuda"
WHISPER_DEVICE=cpu
# Para CPU use "int8", para GPU use "float16"
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=pt

# ── Armazenamento de Áudio ────────────────────────────────────────────────────
AUDIO_STORAGE=local
AUDIO_OUTPUT_DIR=/data/audio_outputs
UPLOAD_DIR=/data/uploads

# ── AWS S3 (opcional, para armazenamento em nuvem) ───────────────────────────
# AWS_ACCESS_KEY_ID=sua_access_key
# AWS_SECRET_ACCESS_KEY=seu_secret_key
# AWS_BUCKET_NAME=vibevoice-audio
# AWS_REGION=us-east-1

# ── Mercado Pago ──────────────────────────────────────────────────────────────
# Obtenha em: https://www.mercadopago.com.br/developers/
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_URL=https://seudominio.com.br/api/payments/webhook

# ── E-mail (SMTP) ─────────────────────────────────────────────────────────────
MAIL_USERNAME=noreply@seudominio.com.br
MAIL_PASSWORD=sua_senha_smtp
MAIL_FROM=noreply@vibevoice.com.br
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# ── Admin Padrão ──────────────────────────────────────────────────────────────
# IMPORTANTE: Mude a senha padrão ANTES do primeiro acesso!
ADMIN_EMAIL=admin@vibevoice.com.br
ADMIN_PASSWORD=TROQUE_ESTA_SENHA_IMEDIATAMENTE

# ── CORS ──────────────────────────────────────────────────────────────────────
# Separe múltiplas origens por vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://seudominio.com.br

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10
MAX_TEXT_LENGTH=5000
MAX_AUDIO_DURATION_SEC=3600

# ── Créditos ─────────────────────────────────────────────────────────────────
FREE_CREDITS=50
CREDIT_PER_MINUTE_TTS=5
CREDIT_PER_MINUTE_ASR=2
CREDIT_PER_CLONE=20
